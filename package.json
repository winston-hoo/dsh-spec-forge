    "@deepseek-ai/schemastery": ">=1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "prompt-engineering",
